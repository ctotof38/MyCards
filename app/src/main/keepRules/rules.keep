# Regles R8 pour la minification et le shrinking
# Conserver le modèle de données utilisé par Gson
-keep class com.totof.mycards.LoyaltyCard { *; }
-keepclassmembers class com.totof.mycards.LoyaltyCard { *; }

# Conserver les enums ZXing utilises pour le format des codes-barres
-keep class com.google.zxing.BarcodeFormat { *; }
-keepclassmembers enum com.google.zxing.BarcodeFormat { *; }
